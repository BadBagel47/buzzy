          },
          "image": {
            ".validate": "newData.isString() && newData.val().length<=2048 && (newData.val()=='' || newData.val().beginsWith('https://') || newData.val().beginsWith('http://'))"
          },
          "textVisible": {
            ".validate": "newData.isBoolean()"
          },
          "shown": {
            ".read": "auth != null",
            ".validate": "newData.isBoolean()"
          },
          "source": {
            ".validate": "newData.val()=='quick' || newData.val()=='prepared'"
          },
          "loadKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "settings": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/owner').val() == auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists() || root.child('rooms').child($code).child('viewers').child(auth.uid).exists())",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid",
          "$other": {
            ".validate": false
          },
          "leaderboard": {
            ".validate": "newData.isBoolean()"
          },
          "playerBuzzOrder": {
            ".validate": "newData.isBoolean()"
          },
          "buzzOrderNames": {
            ".validate": "newData.isBoolean()"
          },
          "ownScore": {
            ".validate": "newData.isBoolean()"
          },
          "showQuestionPoints": {
            ".validate": "newData.isBoolean()"
          },
          "sounds": {
            ".validate": "newData.isBoolean()"
          },
          "answerSounds": {
            ".validate": "newData.isBoolean()"
          },
          "animations": {
            ".validate": "newData.isBoolean()"
          },
          "celebration": {
            ".validate": "newData.isBoolean()"
          },
          "showQuestionInfoDefault": {
            ".validate": "newData.isBoolean()"
          },
          "shareLeaderboard": {
            ".validate": "newData.isBoolean()"
          },
          "allowJoinDuringQuestion": {
            ".validate": "newData.isBoolean()"
          },
          "viewerQuestion": {
            ".validate": "newData.isBoolean()"
          },
          "viewerTimer": {
            ".validate": "newData.isBoolean()"
          },
          "viewerBuzzOrder": {
            ".validate": "newData.isBoolean()"
          },
          "viewerLeaderboard": {
            ".validate": "newData.isBoolean()"
          },
          "viewerCelebration": {
            ".validate": "newData.isBoolean()"
          },
          "viewerJoinScreen": {
            ".validate": "newData.isBoolean()"
          },
          "viewerOn": {
            ".validate": "newData.isBoolean()"
          },
          "viewerQuestionNumber": {
            ".validate": "newData.isBoolean()"
          },
          "viewerView": {
            ".validate": "newData.isString() && (newData.val() == 'standby' || newData.val() == 'join' || newData.val() == 'game' || newData.val() == 'leaderboard')"
          }
        },
        "selection": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/owner').val() == auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists() || root.child('rooms').child($code).child('viewers').child(auth.uid).exists())",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid",
          ".validate": "newData.hasChildren(['r','a','uid','order'])",
          "r": {
            ".validate": "newData.val()==root.child('rooms').child($code).child('control').child('r').val()"
          },
          "a": {
            ".validate": "newData.val()==root.child('rooms').child($code).child('control').child('a').val()"
          },
          "uid": {
            ".validate": "newData.isString() && root.child('rooms').child($code).child('members').child(newData.val()).exists()"
          },
          "order": {
            ".validate": "newData.isNumber() && newData.val()>=1 && newData.val()<=12"
          },
          "$other": {
            ".validate": false
          }
        },
        "moderation": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/owner').val() == auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists() || root.child('rooms').child($code).child('viewers').child(auth.uid).exists())",
          "$uid": {
            ".write": "(auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid) || (auth != null && auth.uid==$uid && data.val()=='kicked' && newData.val()=='active')",
            ".validate": "(root.child('rooms').child($code).child('members').child($uid).exists()) && (newData.val()=='active' || newData.val()=='kicked' || newData.val()=='banned')"
          }
        },
        "loads": {
          "$key": {
            ".read": "auth != null && (root.child('rooms').child($code).child('meta/owner').val() == auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists())",
            "$uid": {
              ".write": "auth != null && auth.uid==$uid && root.child('rooms').child($code).child('members').child(auth.uid).exists() && $key==root.child('rooms').child($code).child('presentation/loadKey').val()",
              ".validate": "newData.val()=='ready' || newData.val()=='failed'"
            }
          }
        },
        "celebration": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/owner').val() == auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists() || root.child('rooms').child($code).child('viewers').child(auth.uid).exists())",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid",
          ".validate": "newData.hasChildren(['id','at'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length<=100"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val()==now"
          },
          "$other": {
            ".validate": false
          }
        },
        "adjustments": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/owner').val() == auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists() || root.child('rooms').child($code).child('viewers').child(auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid",
            ".validate": "newData.hasChildren(['id','before','after','at']) && newData.child('before').val()==root.child('rooms').child($code).child('scores').child($uid).val() && newData.child('after').val()==newData.parent().parent().child('scores').child($uid).val()",
            "id": {
              ".validate": "newData.isString() && newData.val().length<=100"
            },
            "before": {
              ".validate": "newData.isNumber()"
            },
            "after": {
              ".validate": "newData.isNumber()"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val()==now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "archive": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid"
        },
        "viewerSeats": {
          ".read": "auth != null",
          "$slot": {
            ".write": "auth != null && ((!data.exists() && newData.parent().parent().child('viewers').child(auth.uid).child('slot').val() == $slot) || (!newData.exists() && ((auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid) || root.child('rooms').child($code).child('viewers').child(auth.uid).child('slot').val() == $slot)))",
            ".validate": "$slot.matches(/^(0|1|2|3)$/) && newData.val() == true"
          }
        },
        "viewers": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && ((auth.uid == $uid && !data.exists() && root.child('rooms').child($code).child('control').exists()) || (!newData.exists() && (auth.uid == $uid || (auth != null && root.child('rooms').child($code).child('meta/owner').val() == auth.uid))))",
            ".validate": "newData.hasChildren(['at','slot']) && newData.child('at').val() == now && !root.child('rooms').child($code).child('viewerSeats').child(newData.child('slot').val()).exists() && newData.parent().parent().child('viewerSeats').child(newData.child('slot').val()).val() == true",
            "at": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0"
            },
            "slot": {
              ".validate": "newData.isString() && newData.val().matches(/^(0|1|2|3)$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
